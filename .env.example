# Railway automaticky vytvoří DATABASE_URL, pokud do projektu přidáš plugin PostgreSQL.
# Lokálně si zkopíruj tento soubor jako .env a doplň vlastní hodnoty.

DATABASE_URL=postgres://user:password@localhost:5432/cendturoff

# Cokoliv dlouhého a náhodného. Používá se k podepisování přihlašovacích tokenů.
# Pokud se změní (nebo není nastavené), po restartu serveru se všichni odhlásí.
JWT_SECRET=zmen-me-na-nahodny-dlouhy-retezec

# Railway nastavuje PORT automaticky, lokálně můžeš nechat 3000.
PORT=3000

NODE_ENV=production
